# Local example only. Never commit a populated .env.
# Initial preview without articles. Switch to airtable only when configured.
CONTENT_SOURCE=fixtures
AIRTABLE_BASE_ID=appwkQjq00zjOBZjt
AIRTABLE_TABLE_NAME=Contenus
AIRTABLE_API_KEY=
AIRTABLE_WRITE_API_KEY=
# Optional one-off schema setup, never needed by the site:
AIRTABLE_SCHEMA_API_KEY=

# Authoritative pause must also be set in Netlify production build variables.
PUBLISHING_PAUSED=false
# Enable on Netlify only after the activation checklist.
CONTENT_CONFIRMATION_ENABLED=false
NETLIFY_AUTH_TOKEN=
# SITE_ID and DEPLOY_ID are supplied by Netlify during its build.
