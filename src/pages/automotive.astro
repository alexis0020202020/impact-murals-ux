---
/**
 * /automotive: an outreach page, not a site section.
 *
 * Built from the "Impact Murals: Automotive" deck and translated for the web:
 * natural scrolling, each section as tall as it needs to be, no slides. Sent
 * by email or WhatsApp to people who have not heard of the studio, so it opens
 * on the work (a Ferrari mural, edge to edge) under a campaign line, with a
 * discreet strip of brand marks right under it, then says what the studio does
 * and goes through proof (automotive realism, a BMW painted live, a
 * building-scale mural, two launches), to who is behind it, what a project
 * typically costs (one editorial note), how a project works and how to reach
 * the studio. The artwork leads; type supports it. The range of styles is shown
 * by the projects themselves, not by a section of its own. The copy is the
 * approved final copy, kept word for word in src/content/automotive.ts, in the
 * order of its nine blocks, plus the investment note the owner added between
 * About and How we work.
 *
 * Indexable: it is in the route registry (src/lib/routes.ts, so in the core
 * sitemap), canonical on the www host (AUTOMOTIVE_CANONICAL), and linked
 * from the Murals & Branded Environments page (not from the main navigation).
 * It has no site header or footer, so a visitor sent this link sees one focused
 * page that ends in the contact block, with the site one link away.
 *
 * Every picture and clip is a real file; where each lives and how it was
 * prepared is in docs/AUTOMOTIVE-MEDIA.md.
 */
import { getImage } from "astro:assets";
import "@/styles/automotive.css";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/components/automotive/Hero.astro";
import Brands from "@/components/automotive/Brands.astro";
import WhatWeDo from "@/components/automotive/WhatWeDo.astro";
import Realism from "@/components/automotive/Realism.astro";
import Bmw from "@/components/automotive/Bmw.astro";
import Exterior from "@/components/automotive/Exterior.astro";
import Launch from "@/components/automotive/Launch.astro";
import About from "@/components/automotive/About.astro";
import Investment from "@/components/automotive/Investment.astro";
import Process from "@/components/automotive/Process.astro";
import ContactCta from "@/components/automotive/ContactCta.astro";
import { automotiveSeo } from "@/content/automotive";
import { resolveMedia } from "@/lib/automotive-media";
import { AUTOMOTIVE_CANONICAL } from "@/lib/routes";

/*
  Link preview. This page travels by message, so the picture a messenger shows
  matters more than for an indexed page: the opening picture, cropped to the
  1200x630 JPEG that messengers and social cards read reliably.
*/
const hero = await resolveMedia("AUTOMOTIVE_HERO");
const preview = await getImage({
  src: hero.image,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "center",
  format: "jpeg",
  quality: 82
});
---

<BaseLayout
  title={automotiveSeo.title}
  description={automotiveSeo.description}
  canonical={AUTOMOTIVE_CANONICAL}
  ogImage={preview.src}
  minimal
>
  <div class="auto-page">
    <Hero />
    <Brands />
    <WhatWeDo />
    <Realism />
    <Bmw />
    <Exterior />
    <Launch />
    <About />
    <Investment />
    <Process />
    <ContactCta />
  </div>
</BaseLayout>

<script>
  import { initAutomotiveMotion } from "@/lib/automotive-motion";
  import { initAutomotiveVideo } from "@/lib/automotive-video";
  initAutomotiveMotion(document);
  initAutomotiveVideo(document);
</script>
