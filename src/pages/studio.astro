---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import OfferMedia from "@/components/OfferMedia.astro";
import ProjectCta from "@/components/ProjectCta.astro";
import ImpactFragment from "@/components/ImpactFragment.astro";
import FragmentMotion from "@/components/FragmentMotion.astro";
import { breadcrumbsFor } from "@/lib/routes";
import { pageSeo } from "@/content/seo";
import { studio } from "@/content/studio";

const trail = await breadcrumbsFor("/studio");
---

<BaseLayout title={pageSeo.studio.title} description={pageSeo.studio.description}>
  <Breadcrumbs trail={trail} />

  <header class="relative overflow-hidden px-[var(--gutter)] pb-20 pt-14 md:pb-32 md:pt-20">
    <ImpactFragment fragment="08" drift={54} driftX={-16} rotate={-8} class="pointer-events-none absolute -right-[4vw] top-[8%] hidden w-[15vw] text-signal opacity-[0.15] md:block" />
    <div class="grid grid-cols-1 gap-y-10 md:grid-cols-12 md:gap-x-10">
      <div class="md:col-span-9">
        <h1 class="headline-display max-w-[10ch] text-[15vw] sm:text-[9.5vw] md:text-[5.7vw] lg:text-[5.1vw]">
          ARTIST-LED. PROJECT-DRIVEN.
        </h1>
      </div>
      <div class="md:col-span-3 md:self-end md:pb-2">
        <p class="body-copy">{studio.lead}</p>
      </div>
    </div>
  </header>

  <section class="relative overflow-hidden px-[var(--gutter)] pb-28 md:pb-44">
    <div class="grid grid-cols-1 gap-y-10 md:grid-cols-12 md:gap-x-10">
      <div class="relative md:col-span-8">
        <OfferMedia
          offer="public-art"
          video={studio.media.video}
          poster={studio.media.poster}
          class="aspect-video"
          label="Studio / artist photography"
        />
        <ImpactFragment fragment="06" drift={46} driftX={20} rotate={7} class="pointer-events-none absolute -bottom-[6vw] -right-[7vw] hidden w-[17vw] text-ink opacity-[0.08] md:block" />
      </div>
      <div class="md:col-span-3 md:col-start-10 md:self-end md:pb-3">
        <p class="body-copy-strong">{studio.grounding}</p>
      </div>
    </div>
  </section>

  <section class="px-[var(--gutter)] pb-32 md:pb-52">
    <div class="grid grid-cols-1 gap-y-16 md:grid-cols-12 md:gap-x-10 md:gap-y-24">
      {studio.model.map((item, index) => (
        <div class:list={[
          "max-w-[29rem]",
          index === 0 ? "md:col-span-4 md:col-start-2" : index === 1 ? "md:col-span-4 md:col-start-7 md:pt-[8vh]" : "md:col-span-4 md:col-start-3 md:pt-[3vh]"
        ]}>
          <h2 class="headline-editorial text-[9vw] sm:text-[5.5vw] md:text-[2.35vw] lg:text-[2.05vw]">{item.title}</h2>
          <p class="body-copy mt-4">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="surface-dark relative min-h-[76svh] overflow-hidden py-24 md:flex md:min-h-[82svh] md:items-center md:py-36">
    <ImpactFragment fragment="10" drift={60} driftX={-16} rotate={10} class="pointer-events-none absolute -right-[4vw] top-[8%] hidden w-[24vw] text-paper opacity-[0.05] md:block" />
    <div class="relative w-full px-[var(--gutter)]">
      <div class="grid grid-cols-1 gap-y-10 md:grid-cols-12 md:gap-x-10">
        <div class="md:col-span-8">
          <h2 class="headline-display max-w-[10ch] text-[14vw] sm:text-[9vw] md:text-[5.4vw] lg:text-[4.85vw]">
            THE IDEA HAS TO WORK IN THE REAL WORLD.
          </h2>
        </div>
        <div class="md:col-span-3 md:col-start-10 md:self-end md:pb-2">
          <p class="font-body text-[15px] leading-relaxed text-paper/72">
            Scale, surface, materials, access and installation are considered while the work is being developed, so the finished result stays close to the approved direction.
          </p>
        </div>
      </div>
    </div>
  </section>

  <ProjectCta
    heading="HAVE A PROJECT IN MIND?"
    body="Tell us what you are planning, whether you have a defined brief or just a starting point. We can discuss the right next step."
    primaryLabel="DISCUSS A PROJECT"
  />
  <FragmentMotion />
</BaseLayout>
