---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import PageHeader from "@/components/PageHeader.astro";
import ProjectCta from "@/components/ProjectCta.astro";
import EditorialList from "@/components/EditorialList.astro";
import Pagination from "@/components/Pagination.astro";
import { isPreviewEnvironment } from "@/lib/publishing";
import {
  breadcrumbsFor,
  pageCount,
  pagePath,
  pageSlice,
  publishedOfType,
  routeFor
} from "@/lib/routes";
import { guidesIndexCopy } from "@/content/editorial-copy";

/**
 * Index for the specialised pages, paginated the same way as the articles.
 *
 * Guides previously had no index at all: they were reachable only through the
 * short related-content selections on other pages, which meant a guide that
 * fell outside those selections had no path to it from the homepage. This is
 * that path.
 */
export async function getStaticPaths() {
  const entries = await publishedOfType("guide");
  if (entries.length === 0) return [];

  return Array.from({ length: pageCount(entries.length) }, (_unused, i) => {
    const page = i + 1;
    return {
      params: { root: page === 1 ? undefined : `page/${page}` },
      props: { page }
    };
  });
}

const { page } = Astro.props;
const base = "/guides";

const all = await publishedOfType("guide");
const entries = pageSlice(all, page);
const total = pageCount(all.length);

const route = await routeFor(pagePath(base, page));
const trail = await breadcrumbsFor(pagePath(base, page));

const title = page === 1 ? "Guides" : `Guides, page ${page}`;
// Distinct per page, not a copy-pasted repeat of page 1's description, while
// still reading as one continuous series rather than unrelated wording.
const description =
  page === 1 ? guidesIndexCopy.lead : `${guidesIndexCopy.lead} Page ${page} of ${total}.`;
---

<BaseLayout title={title} description={description} noindex={route?.noIndex}>
  <Breadcrumbs trail={trail} />
  <PageHeader
    eyebrow={guidesIndexCopy.eyebrow}
    heading={guidesIndexCopy.heading}
    lead={guidesIndexCopy.lead}
  />

  <div class="px-[var(--gutter)] pb-24 md:pb-28">
    {isPreviewEnvironment && entries.some((e) => e.isTestFixture) && (
      <p class="notation mb-8 border border-signal/50 px-4 py-3 text-[10px] leading-relaxed text-signal">
        Development preview: entries marked TEST FIXTURE validate the template and are excluded
        from the production build.
      </p>
    )}

    {total > 1 && (
      <p class="notation mb-6 text-[10px] text-stone/60">
        {`PAGE ${page} OF ${total} · ${all.length} GUIDES`}
      </p>
    )}

    <EditorialList entries={entries} />
    <Pagination base={base} current={page} total={total} />
  </div>

  <ProjectCta />
</BaseLayout>
