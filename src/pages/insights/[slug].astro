---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import StrikeRule from "@/components/StrikeRule.astro";
import ProjectCta from "@/components/ProjectCta.astro";
import ArticleBody from "@/components/ArticleBody.astro";
import EditorialCommercialIntro from "@/components/EditorialCommercialIntro.astro";
import { loadContentRecords } from "@/lib/content-source";
import { renderMarkdown } from "@/lib/content-source/markdown";
import { filterPublic } from "@/lib/publishing";
import { breadcrumbsFor, routeFor } from "@/lib/routes";
import { relatedEditorial } from "@/lib/relations";
import { offers } from "@/content/offers";
import { global } from "@/content/global";
import { toJsonLd } from "@/lib/json-ld";
import { commercialHubFor } from "@/content/commercial-hubs";

/**
 * Article template. Routes come from the editorial source through the shared
 * publishing gate, so a draft, a future entry or a test fixture produces no
 * route at all in a production build.
 */
export async function getStaticPaths() {
  const published = filterPublic(await loadContentRecords());
  return published
    .filter((record) => record.type === "insight")
    .map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const offer = offers.find((o) => o.key === entry.offer);
const commercialHub = commercialHubFor(entry.commercialHubCode);
const path = `/insights/${entry.slug}`;
const trail = await breadcrumbsFor(path);
// Indexation is read from the route registry, so this tag and the sitemap
// always express the same decision.
const route = await routeFor(path);
const related = await relatedEditorial(entry);
const body = renderMarkdown(entry.body);

const published = new Date(entry.publishAt);
const updated = entry.updatedAt ? new Date(entry.updatedAt) : null;
// Only shown when it is genuinely later than publication, so an edit made
// before going live never reads as an update.
const showUpdated = updated && updated.getTime() > published.getTime() + 86_400_000;

const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "long",
  year: "numeric"
});

/** Structured data reflects only what is actually present. No invented fields. */
const articleSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: entry.title,
  description: entry.description,
  datePublished: entry.publishAt,
  author: { "@type": "Person", name: entry.author },
  publisher: { "@type": "Organization", name: global.name },
  mainEntityOfPage: `${global.domain}/insights/${entry.slug}`
};
if (showUpdated) articleSchema.dateModified = entry.updatedAt;
if (entry.image?.src) articleSchema.image = entry.image.src;
---

<BaseLayout title={entry.seoTitle || entry.title} description={entry.description} ogImage={entry.image?.src} noindex={route?.noIndex}>
  <Breadcrumbs trail={trail} currentLabel={entry.title} />

  <article>
    <header class="px-[var(--gutter)] pt-10 pb-8 md:pt-14 md:pb-10">
      {entry.isTestFixture && (
        <p class="notation mb-7 border border-signal/50 px-4 py-3 text-[10px] leading-relaxed text-signal">
          TEST FIXTURE. Validates the article template and is excluded from the production build.
        </p>
      )}

      <h1 class="headline-display max-w-4xl text-[8.6vw] sm:text-[6.2vw] md:text-[3.6vw] lg:text-[3.2vw]">
        {entry.title}
      </h1>

      <p class="mt-6 max-w-2xl font-body text-[18px] leading-relaxed text-stone md:text-lg">
        {entry.description}
      </p>

      <dl class="mt-8 flex flex-wrap gap-x-10 gap-y-3">
        <div>
          <dt class="notation text-[10px] text-stone/70">Author</dt>
          <dd class="notation mt-1.5 text-[11px] text-paper-dim">{entry.author}</dd>
        </div>
        <div>
          <dt class="notation text-[10px] text-stone/70">Published</dt>
          <dd class="notation mt-1.5 text-[11px] text-paper-dim">
            <time datetime={entry.publishAt}>{dateFormat.format(published)}</time>
          </dd>
        </div>
        {showUpdated && (
          <div>
            <dt class="notation text-[10px] text-stone/70">Updated</dt>
            <dd class="notation mt-1.5 text-[11px] text-paper-dim">
              <time datetime={entry.updatedAt}>{dateFormat.format(updated!)}</time>
            </dd>
          </div>
        )}
        {offer && (
          <div>
            <dt class="notation text-[10px] text-stone/70">Focus</dt>
            <dd class="notation mt-1.5 text-[11px] text-paper-dim">{offer.shortTitle}</dd>
          </div>
        )}
      </dl>
    </header>

    <EditorialCommercialIntro offer={entry.offer} />

    {entry.image?.src && (
      <figure class="mt-10 px-[var(--gutter)] md:mt-12">
        <img
          src={entry.image.src}
          alt={entry.image.alt}
          loading="eager"
          decoding="async"
          class="aspect-[16/9] w-full object-cover md:aspect-[16/7]"
        />
        {entry.image.caption && (
          <figcaption class="notation mt-3 text-[10px] text-stone/60">
            {entry.image.caption}
          </figcaption>
        )}
      </figure>
    )}

    <div class="mt-12 px-[var(--gutter)] md:mt-16">
      <ArticleBody body={body} />
    </div>

    {offer && (
      <div class="mt-16 px-[var(--gutter)] md:mt-20">
        <StrikeRule />
        <div class="mt-8 grid grid-cols-1 gap-y-5 md:grid-cols-12 md:items-end md:gap-x-10">
          <div class="md:col-span-7">
            <p class="notation text-[10px] text-stone/70">Related service</p>
            <h2 class="headline-display mt-3 text-[6.4vw] sm:text-[4.4vw] md:text-[2.2vw] lg:text-[1.9vw]">
              {commercialHub?.title ?? offer.title}
            </h2>
            <p class="mt-3 max-w-xl font-body text-[15px] leading-relaxed text-stone">
              {offer.summary}
            </p>
          </div>
          <div class="flex flex-wrap gap-x-7 gap-y-3 md:col-span-4 md:col-start-9">
            <a href={commercialHub?.href ?? `/what-we-do/${offer.slug}`} class="cta-secondary text-[11px]">
              {commercialHub ? "EXPLORE THE SERVICE" : "READ THE OFFER"}
            </a>
            <a
              href={`/discuss-a-project?offer=${offer.key}`}
              class="cta-primary px-6 py-3.5 text-[11px]"
            >
              DISCUSS A PROJECT
            </a>
          </div>
        </div>
      </div>
    )}

    {related.length > 0 && (
      <div class="mt-16 px-[var(--gutter)] md:mt-20">
        <p class="notation text-[10px] text-stone/70">RELATED GUIDES &amp; INSIGHTS</p>
        <ul class="mt-4 flex flex-col">
          {related.map((item) => (
            <li class="border-t border-stone-line/50 last:border-b last:border-stone-line/50">
              <a href={item.href} class="group block py-4">
                <span class="block font-body text-[16px] text-stone transition-colors duration-200 group-hover:text-ink">
                  {item.title}
                </span>
                <span class="notation mt-1.5 block text-[10px] text-stone/60">{item.kind}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </article>

  <div class="mt-20 md:mt-24">
    <ProjectCta />
  </div>

  <script type="application/ld+json" set:html={toJsonLd(articleSchema)} is:inline />
</BaseLayout>
