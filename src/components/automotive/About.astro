---
import { about } from "@/content/automotive";
import Tight from "./Tight.astro";

/*
  Who is behind the work, in type only: no portrait was supplied and none is
  invented. The studio's own words carry it: the first paragraph as the lead and
  the two that follow as body text (who leads the studio, how the team is
  chosen, how the creative direction is held).
*/
const [lead, ...rest] = about.body;
---

<section class="auto-section auto-about" aria-labelledby="auto-about-title">
  <div class="auto-wrap">
    <div class="auto-about-layout">
      <h2 id="auto-about-title" class="headline-display auto-title-lg auto-about-head" data-auto-reveal>{about.headline}</h2>

      <div class="auto-about-copy" data-auto-reveal>
        <p class="auto-lead"><Tight text={lead} /></p>
        {rest.map((paragraph) => <p class="auto-body"><Tight text={paragraph} /></p>)}
      </div>
    </div>
  </div>
</section>
