---
/**
 * The supplied Impact Murals mark. Geometry is never modified here.
 *
 * SIZING CONTRACT: this component sets no width or height utilities of its
 * own. Each caller constrains exactly one axis and lets the other follow the
 * aspect ratio. Passing conflicting pairs (h-full with h-auto) previously
 * shipped both to the element, and because Tailwind emits .h-full after
 * .h-auto, height:100% won against an auto-height parent. Chrome rescues that
 * via the intrinsic ratio, but engines that resolve it as 0 collapse the mark
 * to nothing and the logo disappears. Keep one axis per caller.
 *
 * The width and height attributes below give the element real intrinsic
 * dimensions so the aspect ratio is known even before CSS applies. CSS still
 * overrides them, since stylesheet rules beat presentation attributes.
 */
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
