---
/*
  The station in one frame, drawn in thin line: the artist, the object and the
  guest. A brush meets an object on a table; a guest watches. Labelled
  illustrative wherever it appears; it is not a photograph of any event and
  shows no real product.
*/
---
<svg
  class="mp-svg lc-scene"
  viewBox="0 0 640 420"
  preserveAspectRatio="xMidYMid slice"
  style="--tm:22px"
  role="img"
  aria-labelledby="lc-scene-title lc-scene-desc"
  focusable="false"
>
  <title id="lc-scene-title">Illustrative live customisation station</title>
  <desc id="lc-scene-desc">
    An artist at the left reaches out with a brush to touch a bottle standing on a table. A guest at the right watches
    the brush meet the bottle. Three people's worth of attention on one object.
  </desc>

  <circle class="fill" cx="320" cy="244" r="128" />
  <path class="l-soft" d="M20 372H620" />

  <!-- The table and the object on it -->
  <rect class="fill-ink" x="200" y="282" width="240" height="8" />
  <path class="l" d="M222 290V372M418 290V372" />
  <path class="l-faint" d="M222 332H418" />
  <path class="l" d="M296 232Q296 224 304 224H336Q344 224 344 232V274Q344 282 336 282H304Q296 282 296 274Z" />
  <path class="l" d="M310 224V206H330V224" />
  <rect class="l" x="306" y="192" width="28" height="14" />
  <path class="l-faint" d="M304 234V272" />

  <!-- The artist, the brush and the first mark -->
  <circle class="l" cx="120" cy="168" r="15" />
  <path class="l" d="M98 192Q120 184 142 192L150 282H90Z" />
  <path class="l" d="M106 282V372M134 282V372" />
  <path class="l-soft" d="M140 198L196 232L258 254" />
  <path class="l" d="M258 254L292 244" />
  <path class="l-signal" d="M292 244L298 242" style="stroke-width: 3.5" />

  <!-- The guest, and what they are watching -->
  <circle class="l" cx="520" cy="172" r="14" />
  <path class="l" d="M500 194Q520 186 540 194L546 282H494Z" />
  <path class="l" d="M506 282V372M534 282V372" />
  <path class="l-signal" d="M508 178L350 240" style="stroke-dasharray: 4 6" />

  <text class="t-soft t-small t-mid t-minor" x="120" y="400">THE ARTIST</text>
  <text class="t-soft t-small t-mid t-minor" x="320" y="400">THE OBJECT</text>
  <text class="t-soft t-small t-mid t-minor" x="520" y="400">THE GUEST</text>
</svg>
