---
/*
  One frame of the end-result sequence: the same small artwork as the hero,
  shown as finished tiles laid out on a table, as one assembled work, and
  hung on the wall of an office. Thin line and flat colour, drawn from the same
  tiles as the hero so the three read as three stages of one piece.

  A drawing, labelled as one. The real sequence replaces each frame as its file
  is added (WS_OUT_TILES, WS_OUT_ASSEMBLED, WS_OUT_WALL).
*/
import { mosaic } from "./mosaic";

interface Props {
  kind: "tiles" | "assembled" | "wall";
}

const { kind } = Astro.props;

// The piece is 6 by 4 small tiles, drawn as 3 by 2 canvases of 2 by 2 tiles.
const cell = 24;
const tiles = mosaic(6, 4);
const canvas = cell * 2;

// Where each canvas rests when it is laid out: a slight turn each, never the same.
const turns = [-2.4, 1.6, -1.2, 2.2, -1.8, 1.1];
const labels: Record<string, string> = {
  tiles: "Illustrative frame: six finished canvas tiles laid out on a table, each painted differently.",
  assembled: "Illustrative frame: the six canvas tiles assembled into one finished artwork.",
  wall: "Illustrative frame: the finished artwork hung on an office wall above a low bench."
};

function canvasTiles(c: number, r: number) {
  return tiles.filter((tile) => Math.floor(tile.col / 2) === c && Math.floor(tile.row / 2) === r);
}

const canvases = [0, 1, 2].flatMap((c) => [0, 1].map((r) => ({ c, r, index: r * 3 + c })));
---
<svg class="mp-svg ws-frame" viewBox="0 0 240 180" role="img" aria-label={labels[kind]}>
  {kind === "tiles" && (
    <>
      <path class="l-soft" d="M8 150H232" />
      <path class="l-faint" d="M8 158H232M8 166H232" />
      {canvases.map(({ c, r, index }) => {
        const gap = 11;
        const x = 36 + c * (canvas + gap);
        const y = 28 + r * (canvas + gap);
        return (
          <g transform={`rotate(${turns[index]} ${x + canvas / 2} ${y + canvas / 2})`}>
            <rect x={x + 2} y={y + 3} width={canvas} height={canvas} style="fill: var(--svg-faint)" />
            {canvasTiles(c, r).map((tile) => (
              <rect
                x={x + (tile.col - c * 2) * cell}
                y={y + (tile.row - r * 2) * cell}
                width={cell}
                height={cell}
                style={`fill: ${tile.fill}`}
              />
            ))}
            <rect class="l-soft" x={x} y={y} width={canvas} height={canvas} />
          </g>
        );
      })}
    </>
  )}

  {kind === "assembled" && (
    <>
      <rect x="52" y="36" width={cell * 6} height={cell * 4} style="fill: var(--svg-faint)" />
      <g transform="translate(46 30)">
        {tiles.map((tile) => (
          <rect x={tile.col * cell} y={tile.row * cell} width={cell} height={cell} style={`fill: ${tile.fill}`} />
        ))}
        <path class="l-soft" d={`M${canvas} 0V${cell * 4}M${canvas * 2} 0V${cell * 4}M0 ${canvas}H${cell * 6}`} />
        <rect class="l" x="0" y="0" width={cell * 6} height={cell * 4} />
      </g>
      <path class="l-soft" d="M8 150H232" />
    </>
  )}

  {kind === "wall" && (
    <>
      <path class="l-faint" d="M8 24H232" />
      <path class="l" d="M8 150H232" />
      <path class="l-soft" d="M8 142H232" />
      <path class="l-soft" d="M120 20L74 34M120 20L166 34" />
      <circle class="ink-fill" cx="120" cy="20" r="2.4" />
      <rect x="52" y="40" width={cell * 6} height={cell * 4} style="fill: var(--svg-faint)" />
      <g transform="translate(46 34)">
        {tiles.map((tile) => (
          <rect x={tile.col * cell} y={tile.row * cell} width={cell} height={cell} style={`fill: ${tile.fill}`} />
        ))}
        <rect class="l" x="0" y="0" width={cell * 6} height={cell * 4} />
      </g>
      <rect class="l-soft" x="82" y="130" width="76" height="12" />
      <path class="l-soft" d="M90 142V150M150 142V150" />
    </>
  )}
</svg>
