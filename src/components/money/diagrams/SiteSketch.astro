---
/*
  A small thin-line sketch of one kind of site: a niche, a double-height
  atrium, a circulation route (in plan), columns, a temporary space. Each has
  a dimension line whose figure is left blank in the caption beside it, because
  the site sets it. Illustrative, never a drawing of a real place; hidden from
  assistive technology, since the row's name carries the meaning.
*/
interface Props {
  kind: "niche" | "atrium" | "route" | "column" | "temporary";
}

const { kind } = Astro.props;
---
<svg class="mp-svg inst-sketch" viewBox="0 0 160 112" aria-hidden="true" focusable="false">
  {kind === "niche" && (
    <>
      <path class="l-soft" d="M14 100H146" />
      <path class="l" d="M14 12H146M14 12V100M146 12V100" />
      <rect class="l" x="56" y="28" width="48" height="72" />
      <rect class="l-soft" x="68" y="40" width="24" height="60" />
      <path class="l-soft" d="M56 107H104M56 103V111M104 103V111" />
    </>
  )}
  {kind === "atrium" && (
    <>
      <path class="l-soft" d="M30 100H130" />
      <path class="l" d="M30 6V100M130 6V100M30 6H130" />
      <path class="l-faint" d="M30 54H64" />
      <path class="fill" d="M80 18L66 40L64 100H86Z" />
      <path class="l" d="M64 100H96L102 62L80 18L66 40Z" />
      <path class="l-soft" d="M80 18L86 100M66 40L84 70L102 62" />
      <circle class="l" cx="116" cy="82" r="2.6" />
      <path class="l" d="M111 88Q116 86 121 88L122 98H110Z" />
      <path class="l-soft" d="M16 6V100M10 6H22M10 100H22" />
    </>
  )}
  {kind === "route" && (
    <>
      <path class="l" d="M14 94H128V12M14 70H104V12" />
      <path class="l-signal" d="M14 82H116V20" style="stroke-dasharray: 4 5" />
      <path class="signal" d="M116 12l-5 9h10z" />
      <rect class="ink-fill" x="34" y="66" width="14" height="4" />
      <rect class="ink-fill" x="76" y="66" width="14" height="4" />
      <rect class="ink-fill" x="100" y="36" width="4" height="14" />
    </>
  )}
  {kind === "column" && (
    <>
      <path class="l-soft" d="M10 100H150" />
      <rect class="l" x="36" y="10" width="22" height="90" />
      <rect class="l" x="102" y="10" width="22" height="90" />
      <path class="l-signal" d="M36 34Q47 40 58 34M36 52Q47 58 58 52M36 70Q47 76 58 70" />
    </>
  )}
  {kind === "temporary" && (
    <>
      <path class="l-soft" d="M10 100H150" />
      <rect class="l-dash" x="24" y="22" width="112" height="78" />
      <path class="l" d="M68 100V54L80 30L96 54V100Z" />
      <rect class="l" x="106" y="30" width="20" height="18" />
      <path class="l-soft" d="M106 36H126M112 28V32M120 28V32" />
    </>
  )}
</svg>
