---
interface Props {
  eyebrow: string;
  heading: string;
  lead?: string;
}

const { eyebrow, heading, lead } = Astro.props;
---

<header class="px-[var(--gutter)] pb-16 pt-10 md:pb-24 md:pt-14">
  <div class="grid grid-cols-1 gap-y-7 md:grid-cols-12 md:gap-x-10">
    <p class="notation text-[9px] text-stone md:col-span-2 md:pt-2 md:text-[10px]">{eyebrow}</p>
    <h1 class="headline-display max-w-[12ch] text-[13vw] sm:text-[9vw] md:col-span-7 md:text-[5vw] lg:text-[4.4vw]">
      {heading}
    </h1>
    {lead && (
      <p class="body-copy max-w-md md:col-span-3 md:pt-2">
        {lead}
      </p>
    )}
  </div>
  <div class="mt-12 h-px w-full bg-ink/15 md:mt-16"></div>
</header>
